[Desktop Entry]
Type=Application
Name=Finder
GenericName=File Manager
Comment=Browse the file system and manage files
Exec=finder-linux %U
Icon=finder-linux
Terminal=false
DBusActivatable=true
Categories=System;FileTools;FileManager;Qt;KDE;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;dolphin;kde;
StartupNotify=true
StartupWMClass=org.finderlinux.Finder
X-GNOME-UsesNotifications=true
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=finder-linux --new-window
