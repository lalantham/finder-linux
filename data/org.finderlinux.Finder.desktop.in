[Desktop Entry]
Type=Application
Name=File Manager
GenericName=File Browser
Comment=Browse the file system and manage files
Exec=@CMAKE_INSTALL_FULL_BINDIR@/finder-linux %U
Icon=finder-linux
Terminal=false
DBusActivatable=true
Categories=System;FileTools;FileManager;Qt;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;file;browser;
StartupNotify=true
StartupWMClass=org.finderlinux.Finder
X-GNOME-UsesNotifications=true
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=@CMAKE_INSTALL_FULL_BINDIR@/finder-linux --new-window
